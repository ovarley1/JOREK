! =====================================================================
!  cbm18_circ_pcbench (model199)
!  The circular-limiter CBM18 case (namelist/model302/cbm18_in) at
!  tstep 3 with parallel diffusion (D_par 1, ZK_par 10): a ballooning-
!  unstable pedestal at n = 6, as a test case of the split-field
!  preconditioner. The mesh is small; cbm18's own is n_radial 81,
!  n_pol 128, n_flux 51, n_tht 128.
!
!  Builds (models/mod_settings.f90): n_tor 1, n_plane 1 for stage 1;
!  n_tor 3, n_period 6, n_plane 4 (n = 0, 6) for stages 2 and 3.
!    1. restart .f., use_physics_pc .f.: relax the equilibrium until
!       E_kin(n=0) levels off
!    2. restart .t.: the n = 6 harmonics start from a 1e-10 seed
!    3. restart .t., nstep 1, use_physics_pc .t.
! =====================================================================

&in1

 restart = .f.
 regrid  = .f.
 refinement = .false.

 tstep   = 3.
 nstep   = 1
 nout    = 1

 fbnd(1)   = 2.
 fbnd(2:4) = 0.
 mf        = 0

 freeboundary = .f.
 n_boundary   = 0

 ellip  = 1.
 tria_u = 0.
 tria_l = 0.
 quad_u = 0.
 quad_l = 0.

 xpoint = .f.

 R_geo = 3.0
 Z_geo = 0.
 amin  = 2.

 F0    = 6.

 n_R      = 0
 n_Z      = 0
 n_radial = 13
 n_pol    = 24

 n_flux    = 11
 n_tht     = 24
 n_open    = 0
 n_leg     = 0
 n_private = 0

! radial packing on the pedestal (from cbm18_in)
 xr1  = 0.76
 sig1 = 0.06

 eta       = 1.d-7
 visco     = 1.d-7
 visco_par = 1.d-7

 tauIC = 0.00

 eta_num   = 1.d-10
 visco_num = 1.d-10

! raised from cbm18's 0: the psi couplings of the rho and T equations
 D_par     = 1.d0
 D_perp    = 1.d-6

 ZK_par    = 10.d0
 ZK_perp   = 1.d-6

 FF_0 = 3.28
 FF_1 = 0.
 FF_coef(1)  = -0.328
 FF_coef(2)  = -2.924
 FF_coef(3)  =  2.297
 FF_coef(4)  =  0.1895
 FF_coef(5)  =  0.5149
 FF_coef(6)  = -1.226d0
 FF_coef(7)  =  0.5974d0
 FF_coef(8)  =  0.0424d0

 heatsource     = 0.d0
 particlesource = 0.d0

! T_coef(1:3) cubic in psi_n, (4) barrier width, (5) barrier position
 T_0 = 0.038727
 T_1 = 0.
 T_coef(1) = -0.2191
 T_coef(2) = -0.1901
 T_coef(3) =  0.0503
 T_coef(4) =  0.0398
 T_coef(5) =  0.5893

 rho_0 = 1.
 rho_1 = 1.
 rho_coef(1)  =  0.
 rho_coef(2)  =  0.
 rho_coef(3)  =  0.
 rho_coef(4)  = 99.
 rho_coef(5)  = 99.

 iter_precon    = 22
 gmres_m        = 20
 gmres_4        = 1.d0
 gmres_max_iter = 200
 gmres_tol      = 1.d-8

! --- physics PC -------------------------------------------------------
! eliminated Dirichlet DOFs instead of the 1e12 penalty, in the system
! matrix too: keep it the same in runs that are compared
 eliminate_boundary_dofs      = .t.

! the split-field preconditioner, configured by the physics_pc_sf_* entries
 use_physics_pc               = .t.

! linear solves through PETSc
 use_strumpack     = .f.
 use_strumpack_eq  = .f.
 use_strumpack_prj = .f.
 use_mumps         = .f.
 use_mumps_eq      = .f.
 use_mumps_prj     = .f.
 use_pastix        = .f.
 use_pastix_eq     = .f.
 use_pastix_prj    = .f.
 use_petsc_eq      = .t.
/
