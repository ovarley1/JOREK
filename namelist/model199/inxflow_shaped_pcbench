! =====================================================================
!  inxflow_shaped_pcbench (model199)
!  inxflow_circ_pcbench with an elongated limiter plasma (ellip 1.7,
!  triangularity 0.1, up/down symmetric, closed field lines), eta 2e-5,
!  which drives a resistive n = 6 mode on the pedestal, and n_flux 41:
!  a test case of the split-field preconditioner.
!
!  Builds (models/mod_settings.f90): n_tor 1, n_period 1, n_plane 1 for
!  stage 1; n_tor 3, n_period 6, n_plane 4 (n = 0, 6) for stages 2 and 3.
!    1. restart .f., the tstep ramp below (a start at tstep 3 diverges)
!    2. restart .t., tstep_n 3.d0, nstep_n 500
!    3. restart .t., nstep 1, use_physics_pc .t.
! =====================================================================

&in1

 restart = .f.
 regrid  = .f.

 tstep_n   = 1.d-3,1.d-2,1.d-1,1.d0,3.d0
 nstep_n   = 10,10,10,10,10

 nout = 5

 freeboundary = .f.

 fbnd(1)   = 2.
 fbnd(2:4) = 0.
 mf        = 0

! --- limiter geometry -------------------------------------------------
 ellip  = 1.7
 tria_u = 0.1
 tria_l = 0.1
 quad_u = 0.
 quad_l = 0.

 xpoint = .f.
 xampl  = 0.
 xsig   = 0.6
 xwidth = 1.5
 xtheta = 4.7
 xshift = 0.0

 R_begin = 2.9
 R_end   = 3.1
 Z_begin = -0.1
 Z_end   = 0.1

 R_geo = 3.0
 Z_geo = 0.
 amin  = 1.

 F0    = 3.0

 n_R      = 0
 n_Z      = 0
 n_radial = 81
 n_pol    = 128

 n_flux    = 41
 n_tht     = 64
 n_open    = 0
 n_leg     = 0
 n_private = 0

 eta   = 2.d-5
 visco = 4.d-6

! numerical resistivity is required for this case
 eta_num = 3.d-10

 D_par     = 0.d0
 D_perp(1) = 1.d-5
 D_perp(2) = 0.85d0
 D_perp(3) = 0.d0
 D_perp(4) = 0.01d0
 D_perp(5) = 0.92d0

 ZK_par     = 10.d0
 ZK_perp(1) = 1.d-5
 ZK_perp(2) = 0.85d0
 ZK_perp(3) = 0.d0
 ZK_perp(4) = 0.01d0
 ZK_perp(5) = 0.92d0

 FF_0 = 1.6
 FF_1 = 0.
 FF_coef(1)  = -1.0
 FF_coef(2)  = 0.d0
 FF_coef(3)  = 0.d0
 FF_coef(4)  = 0.03d0
 FF_coef(5)  = 1.0d0
 FF_coef(6)  = -0.06d0
 FF_coef(7)  = 0.90d0
 FF_coef(8)  = 0.07d0

 heatsource     = 1.d-7
 particlesource = 5.d-6

 T_0 = 1.5d-2
 T_1 = 3.d-4
 T_coef(1) = -0.66d0
 T_coef(2) = +0.0d0
 T_coef(3) = 0.d0
 T_coef(4) = 0.08d0
 T_coef(5) = 0.94d0

 rho_0 = 1.
 rho_1 = 0.01
 rho_coef(1)  =  0.0
 rho_coef(2)  =  0.0
 rho_coef(3)  =  0.0
 rho_coef(4)  =  0.08
 rho_coef(5)  =  0.94d0

 iter_precon    = 22
 gmres_m        = 20
 gmres_4        = 1.d0
 gmres_max_iter = 200
 gmres_tol      = 1.d-8

! --- physics PC -------------------------------------------------------
! eliminated Dirichlet DOFs instead of the 1e12 penalty, in the system
! matrix too: keep it the same in runs that are compared
 eliminate_boundary_dofs      = .f.

! the split-field preconditioner, configured by the physics_pc_sf_* entries
 use_physics_pc               = .f.

! linear solves through PETSc
 use_strumpack     = .f.
 use_strumpack_eq  = .f.
 use_strumpack_prj = .f.
 use_mumps         = .f.
 use_mumps_eq      = .f.
 use_mumps_prj     = .f.
 use_pastix        = .f.
 use_pastix_eq     = .f.
 use_pastix_prj    = .f.
 use_petsc_eq      = .t.
/
