! =====================================================================
!  inxflow600_circ_pcbench (model199)
!  The physics of reg_tests/testcases/inxflow_600_vpar_T_all (pedestal,
!  ZK_par 100, ohmic heating, edge and gaussian sources) without v_par, on
!  the circular limiter of inxflow_circ_pcbench, with eta 2e-5 instead of
!  2e-6: n = 6 is ideal-stable here, and eta 2e-5 drives a resistive n = 6
!  mode. model199 has no Taylor-Galerkin terms, so eta_num and visco_num
!  stabilise. n_flux 24: the GMG backends need (n_flux-1) even (model600's
!  deck uses 25).
!
!  Builds (models/mod_settings.f90): n_tor 1, n_period 1, n_plane 1 for
!  stage 1; n_tor 3, n_period 6, n_plane 4 (n = 0, 6) for stages 2 and 3.
!    1. restart .f., the tstep ramp below (a start at tstep 3 diverges)
!    2. restart .t., tstep_n 3.d0, nstep_n 1000
!    3. restart .t., preconditioner runs that differ only in the physics
!       PC block
! =====================================================================

&in1

 restart = .f.
 regrid  = .f.

 tstep_n   = 1.d-3,1.d-2,1.d-1,1.d0,3.d0
 nstep_n   = 10,10,10,10,10

 nout = 5

 n_tor_fft_thresh = 2

 freeboundary = .f.

 fbnd(1)   = 2.
 fbnd(2:4) = 0.
 mf        = 0

! --- circular limiter geometry ---------------------------------------
 ellip  = 1.
 tria_u = 0.
 tria_l = 0.
 quad_u = 0.
 quad_l = 0.

 xpoint = .f.
 xampl  = 0.
 xsig   = 0.6
 xwidth = 1.5
 xtheta = 4.7
 xshift = 0.0

 R_begin = 2.9
 R_end   = 3.1
 Z_begin = -0.1
 Z_end   = 0.1

 R_geo = 3.0
 Z_geo = 0.
 amin  = 1.

 F0    = 3.0

! --- mesh --------------------------------------------------------------
 n_R      = 0
 n_Z      = 0
 n_radial = 41
 n_pol    = 64

 n_flux    = 24
 n_tht     = 32
 n_open    = 0
 n_leg     = 0
 n_private = 0

! --- transport (inxflow_600_vpar_T_all, eta raised as the drive) ------
 eta       = 2.d-5
 eta_ohmic = 1.d-7
 visco     = 4.d-6

 eta_num   = 3.d-10
 visco_num = 1.d-11

 D_par     = 0.d0
 D_perp(1) = 1.d-5
 D_perp(2) = 0.85d0
 D_perp(3) = 0.d0
 D_perp(4) = 0.01d0
 D_perp(5) = 0.92d0

 ZK_par     = 100.d0
 ZK_perp(1) = 1.d-5
 ZK_perp(2) = 0.85d0
 ZK_perp(3) = 0.d0
 ZK_perp(4) = 0.01d0
 ZK_perp(5) = 0.92d0

! --- equilibrium ------------------------------------------------------
 FF_0 = 1.6
 FF_1 = 0.
 FF_coef(1)  = -1.0
 FF_coef(2)  = 0.d0
 FF_coef(3)  = 0.d0
 FF_coef(4)  = 0.03d0
 FF_coef(5)  = 1.0d0
 FF_coef(6)  = -0.06d0
 FF_coef(7)  = 0.90d0
 FF_coef(8)  = 0.07d0

 T_0 = 1.5d-2
 T_1 = 3.d-4
 T_coef(1) = -0.66d0
 T_coef(2) = +0.0d0
 T_coef(3) = 0.d0
 T_coef(4) = 0.08d0
 T_coef(5) = 0.94d0

 rho_0 = 1.
 rho_1 = 0.01
 rho_coef(1)  =  0.0
 rho_coef(2)  =  0.0
 rho_coef(3)  =  0.0
 rho_coef(4)  =  0.08
 rho_coef(5)  =  0.94d0

! --- sources ----------------------------------------------------------
 heatsource                = 1.d-7
 particlesource            = 5.d-6
 edgeparticlesource        = 1.d-7
 edgeparticlesource_psin   = 1.d0
 edgeparticlesource_sig    = 0.03d0
 particlesource_gauss      = 1.d-7
 particlesource_gauss_psin = 0.d0
 particlesource_gauss_sig  = 0.1d0
 heatsource_gauss          = 1.d-8
 heatsource_gauss_psin     = 0.d0
 heatsource_gauss_sig      = 0.1d0

! not implemented in model199
 bootstrap = .f.
 NEO       = .f.

! --- solver -----------------------------------------------------------
 iter_precon    = 22
 gmres_m        = 20
 gmres_4        = 1.d0
 gmres_max_iter = 200
 gmres_tol      = 1.d-8

! --- physics PC -------------------------------------------------------
! eliminated Dirichlet DOFs instead of the 1e12 penalty, in the system
! matrix too: keep it the same in runs that are compared
 eliminate_boundary_dofs      = .f.

! the split-field preconditioner, configured by the physics_pc_sf_* entries
 use_physics_pc               = .f.

! linear solves through PETSc
 use_strumpack     = .f.
 use_strumpack_eq  = .f.
 use_strumpack_prj = .f.
 use_mumps         = .f.
 use_mumps_eq      = .f.
 use_mumps_prj     = .f.
 use_pastix        = .f.
 use_pastix_eq     = .f.
 use_pastix_prj    = .f.
 use_petsc_eq      = .t.
/
