! =====================================================================
!  intear_dtm_chipar (model199)
!  intear_dtm with 100x parallel heat diffusion (ZK_par 1 -> 100,
!  ZK_par/ZK_perp = 1e9); equilibrium and FF' file (intear_dtm_ffprime.dat
!  in the run directory) as in intear_dtm. Build with n_tor 3, n_period 1.
! =====================================================================

&in1

 restart = .f.
 regrid  = .f.
 refinement=.false.
 tstep   = 1.
 nstep   = 0
 tstep_n = 1.d0,1.d1,1.d2,1.d3
 nstep_n = 10,10,10,200

 nout = 10

! rst_hdf5 = 1    ! = 0 ; restart from binary files
!                 ! = 1 ; restart from HDF5 files

 fbnd(1)   = 2.
 fbnd(2:4) = 0.
 mf        = 0

 ellip  = 1.
 tria_u = 0.
 tria_l = 0.
 quad_u = -0.
 quad_l = -0.

 freeboundary = .f.

 xampl  = +0.
 xsig   = 0.6
 xwidth = 1.5
 xtheta = 4.7
 xshift = 0.0
 xpoint = .f.

 R_begin = 2.9
 R_end   = 3.1
 Z_begin = -0.1
 Z_end   = 0.1

 R_geo = 3.0
 Z_geo = 0.

 F0    = 3.0

 amin     = 1.

 n_R      = 0
 n_Z      = 0
 n_radial = 51
 n_pol    = 16

 n_flux   = 41
 n_tht    = 16
 n_open   = 0
 n_leg    = 0
 n_private = 0

! radial accumulation (in s = sqrt(psi_N)) at the two q = 2 surfaces:
! 15 flux surfaces between them instead of 8, ds = 0.012 there
 xr1  = 0.316
 sig1 = 0.08
 xr2  = 0.50
 sig2 = 0.08

 eta   = 1.d-6
 visco = 1.d-7

 eta_num = 0.d-10
 visco_num = 0.d0

 D_par  = 0.d0
 D_perp = 1.d-7

 ZK_par  = 1.d2
 ZK_perp = 1.d-7

 ffprime_file = 'intear_dtm_ffprime.dat'

 heatsource     = 0.d0
 particlesource = 0.d0

 T_0 = 1.d-6
 T_1 = 1.d-8
 T_coef(1) = -0.8d0
 T_coef(2) = +0.0d0
 T_coef(3) = 0.d0
 T_coef(4) = 1.d0
 T_coef(5) = 5.d0

 rho_0 = 1.
 rho_1 = 1.
 rho_coef(1)  =  0.0
 rho_coef(2)  =  0.0
 rho_coef(3)  =  0.0
 rho_coef(4)  =  1.d0
 rho_coef(5)  =  5.d0

 iter_precon = 22
 gmres_m = 20
 gmres_4 = 1.d0
 gmres_max_iter = 200
 gmres_tol = 1.d-8

! --- boundary DOF treatment and solver flags -------------------------
 eliminate_boundary_dofs = .t.

! linear solves through PETSc
 use_strumpack     = .f.
 use_strumpack_eq  = .f.
 use_strumpack_prj = .f.
 use_mumps         = .f.
 use_mumps_eq      = .f.
 use_mumps_prj     = .f.
 use_pastix        = .f.
 use_pastix_eq     = .f.
 use_pastix_prj    = .f.
 use_petsc_eq      = .t.

! --- physics PC: the split-field preconditioner (physics_pc_sf_* entries)
 use_physics_pc               = .t.
/
