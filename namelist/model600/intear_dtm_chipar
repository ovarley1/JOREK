! =====================================================================
!  intear_dtm_chipar (model600, no v_par)
!  namelist/model600/intear_dtm with 100x parallel heat diffusion
!  (ZK_par 1 -> 100, ZK_par/ZK_perp = 1e9); equilibrium, FF' file and build
!  as there.
! =====================================================================

&in1

 restart = .f.
 regrid  = .f.
 refinement=.false.

 tstep_n = 1.d0,1.d1,3.d1
 nstep_n = 10,10,600

 nout = 20

 fbnd(1)   = 2.
 fbnd(2:4) = 0.
 mf        = 0

 ellip  = 1.
 tria_u = 0.
 tria_l = 0.
 quad_u = -0.
 quad_l = -0.

 freeboundary = .f.

 xampl  = +0.
 xsig   = 0.6
 xwidth = 1.5
 xtheta = 4.7
 xshift = 0.0
 xpoint = .f.

 R_begin = 2.9
 R_end   = 3.1
 Z_begin = -0.1
 Z_end   = 0.1

 R_geo = 3.0
 Z_geo = 0.

 F0    = 3.0

 amin     = 1.

 n_R      = 0
 n_Z      = 0
 n_radial = 51
 n_pol    = 32

 n_flux   = 61
 n_tht    = 32
 n_open   = 0
 n_leg    = 0
 n_private = 0

! radial accumulation (in s = sqrt(psi_N)) at the two q = 2 surfaces
 xr1  = 0.316
 sig1 = 0.08
 xr2  = 0.50
 sig2 = 0.08

 eta   = 1.d-6
 visco = 1.d-7

 eta_num   = 0.d0
 visco_num = 0.d0

! --- model600-only physics: matched to model199 ------------------------
 tauIC     = 0.d0
 bootstrap = .f.
 NEO       = .f.
 tgnum_psi = 0.d0
 tgnum_u   = 0.d0
 tgnum_zj  = 0.d0
 tgnum_w   = 0.d0
 tgnum_rho = 0.d0
 tgnum_T   = 0.d0
 eta_coul_log_dep = .f.
 visco_old_setup  = .t.

 D_par     = 0.d0
 D_perp(1) = 1.d-7

 ZK_par     = 1.d2
 ZK_perp(1) = 1.d-7

 ffprime_file = 'intear_dtm_ffprime.dat'

 heatsource     = 0.d0
 particlesource = 0.d0

 T_0 = 1.d-6
 T_1 = 1.d-8
 T_coef(1) = -0.8d0
 T_coef(2) = +0.0d0
 T_coef(3) = 0.d0
 T_coef(4) = 1.d0
 T_coef(5) = 5.d0

 rho_0 = 1.
 rho_1 = 1.
 rho_coef(1)  =  0.0
 rho_coef(2)  =  0.0
 rho_coef(3)  =  0.0
 rho_coef(4)  =  1.d0
 rho_coef(5)  =  5.d0

 iter_precon    = 22
 gmres_m        = 20
 gmres_4        = 1.d0
 gmres_max_iter = 200
 gmres_tol      = 1.d-8

 eliminate_boundary_dofs = .f.
 use_physics_pc          = .f.

! linear solves through PETSc
 use_strumpack     = .f.
 use_strumpack_eq  = .f.
 use_strumpack_prj = .f.
 use_mumps         = .f.
 use_mumps_eq      = .f.
 use_mumps_prj     = .f.
 use_pastix        = .f.
 use_pastix_eq     = .f.
 use_pastix_prj    = .f.
 use_petsc_eq      = .t.
/
